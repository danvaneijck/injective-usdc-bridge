{
  "name": "injective-usdc-bridge",
  "version": "0.0.0",
  "description": "Native USDC bridge to and from Injective over Circle CCTP V2: chain registry, burn builders, attestation client and delivery status.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    },
    "./react/styles.css": "./dist/react/styles.css"
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "keywords": [
    "injective",
    "usdc",
    "cctp",
    "bridge",
    "circle"
  ],
  "scripts": {
    "build": "tsup && cp src/react/styles.css dist/react/styles.css",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify-chains": "tsx scripts/verify-chains.ts",
    "live-withdraw": "tsx scripts/live-withdraw.ts",
    "live-solana-deposit": "tsx scripts/live-solana-deposit.ts",
    "live-solana-claim": "tsx scripts/live-solana-claim.ts",
    "live-solana-refund": "tsx scripts/live-solana-refund.ts",
    "verify-solana-claims": "tsx scripts/verify-solana-claims.ts"
  },
  "dependencies": {
    "@noble/curves": "^1.9.1",
    "@noble/hashes": "^1.8.0",
    "@scure/base": "^1.2.6",
    "viem": "^2.57.7"
  },
  "devDependencies": {
    "@solana/web3.js": "1.98.4",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.5.1",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22.12"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
