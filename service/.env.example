# mainnet | testnet
NETWORK=mainnet
# shadow: index + track only, never sends. relay: also mints deposits into Injective.
MODE=shadow
PORT=8787
DB_PATH=/data/bridge.sqlite

# Required for MODE=relay. A file holding the relayer's hex private key (mount it read-only).
# RELAYER_KEY_FILE=/run/secrets/relayer.key
# Relayer INJ balance below which /v1/health reports low. Keep it under the
# keeper's refill mark (KEEPER_RELAYER_LOW_INJ), so low means the keeper is stuck.
RELAYER_LOW_INJ=0.02

# Refill keeper (MODE=relay on mainnet): swaps gas-drop fees to INJ through
# Choice's aggregator and tops up BridgeReceiver's float and the relayer.
# KEEPER=on
# KEEPER_FLOAT_LOW_INJ=0.04
# KEEPER_FLOAT_TARGET_INJ=0.06
# KEEPER_RELAYER_LOW_INJ=0.03
# KEEPER_RELAYER_TARGET_INJ=0.05
# KEEPER_MIN_SWAP_USDC=0.5
# KEEPER_MAX_SWAP_USDC=5
# KEEPER_SLIPPAGE_BPS=100
# CHOICE_ROUTE_API=https://evm-api.choice.exchange

# BridgeReceiver (gas-drop deposits). Defaults to the deployed mainnet one,
# 0xcA5A96ECF72B3656eF7cF60BDAA42FCdb218cd4A.
# BRIDGE_RECEIVER=0x...
# v1 GasDropReceivers to keep completing. Defaults to mainnet v4 + v3.
# LEGACY_RECEIVERS=0x...,0x...

# Comma-separated registry keys; default is every EVM chain in the registry.
# CHAINS=injective,ethereum,base,arbitrum
# First-run lookback for chains with no cursor yet.
START_LOOKBACK_SEC=21600

# Seconds after attestation before we mint a plain deposit (lets a user's own mint land first).
DEPOSIT_GRACE_SEC=15
# Seconds before we relay a burn pinned to a v1 receiver (v1's backend relays those itself).
LEGACY_GRACE_SEC=120
# Plain deposits below this many USDC are left for the depositor to mint (dust costs more gas than it moves).
MIN_RELAY_PLAIN_USDC=0.10

IRIS_RPS=5
LOG_LEVEL=info

# Put your own RPCs ahead of the public ones, per CCTP domain: RPC_<domain>=url1,url2
# Used for reads and sends only (heads, receipts, usedNonces, mints).
# RPC_29=http://172.30.0.1:8545
#
# eth_getLogs endpoints, separately, as url@span: LOG_RPC_<domain>=url@span,url@span
# Never point these at a pruning node: it answers old ranges with an EMPTY
# result instead of an error, and burns in that range are silently missed.
# LOG_RPC_19=https://your-keyed-hyperevm-rpc@1000
